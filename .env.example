# ============================================================
# FairHire AI — Environment Variables Template
# Copy to .env.local and fill in real values.
# NEVER commit real secrets. Use a secret manager in production.
# ============================================================

# ----- Database -----
# Application role (RLS enforced). Never use the superuser here.
DATABASE_URL="postgresql://fairhire_app:changeme@localhost:5432/fairhire"
# Higher-privilege role used only by Prisma migrations
DATABASE_MIGRATE_URL="postgresql://fairhire_migrate:changeme@localhost:5432/fairhire"

# ----- Object Storage (S3-compatible / Cloudflare R2) -----
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_QUARANTINE="fairhire-quarantine"
S3_BUCKET_CLEAN="fairhire-clean"
S3_BUCKET_AUDIT_ANCHOR="fairhire-audit-anchor"
# Public URL for pre-signed URLs (use same as endpoint in local dev)
S3_PUBLIC_URL="http://localhost:9000"

# ----- Auth (Auth.js / NextAuth v5) -----
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# OAuth providers (optional; leave blank to use credentials only in dev)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# SAML/OIDC for enterprise (paid tier)
SAML_CERT=""
SAML_PRIVATE_KEY=""

# ----- LLM Gateway -----
LLM_PROVIDER="google"           # google | openai | anthropic
LLM_MODEL_PINNED="gemini-2.0-flash-001"
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
# Fallback (optional)
LLM_FALLBACK_PROVIDER=""
LLM_FALLBACK_MODEL=""
# Cost controls (USD per day, per tenant)
LLM_DAILY_BUDGET_PER_TENANT="5.00"

# ----- Virus Scanning (ClamAV) -----
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# ----- Queue (pg-boss — uses the same Postgres) -----
# pg-boss uses DATABASE_URL; no extra config needed

# ----- Encryption -----
# 32-byte hex key for AES-256-GCM encryption of PII and mask maps
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# ----- Email (local: MailHog on port 8025) -----
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="noreply@fairhire.local"

# ----- Feature Flags -----
FEATURE_AI_AMHARIC_DEFAULT="false"   # per-tenant flag; off until eval passes
FEATURE_EQUITY_DASHBOARD="true"

# ----- App URLs -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# ----- Observability -----
# Sentry DSN (leave blank to disable in dev)
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=""
